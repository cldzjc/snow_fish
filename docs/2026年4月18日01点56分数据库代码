);
CREATE TABLE public.entities (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  entity_type text NOT NULL,
  title text NOT NULL,
  content text,
  extra_data jsonb DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  comment_count integer DEFAULT 0,
  comment_updated_at timestamp with time zone,
  audit_status text NOT NULL DEFAULT 'pending_review'::text CHECK (audit_status = ANY (ARRAY['pending_review'::text, 'approved'::text, 'rejected'::text])),
  sale_status text NOT NULL DEFAULT 'active'::text CHECK (sale_status = ANY (ARRAY['active'::text, 'pending_payment'::text, 'paid'::text, 'waiting_shipment'::text, 'shipped'::text, 'waiting_receipt'::text, 'sold_out'::text, 'hidden'::text, 'rejected'::text])),
  stock_count integer NOT NULL DEFAULT 1,
  sold_count integer NOT NULL DEFAULT 0,
  reviewed_by uuid,
  reviewed_at timestamp with time zone,
  review_note text,
  CONSTRAINT entities_pkey PRIMARY KEY (id),
  CONSTRAINT entities_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id),
  CONSTRAINT entities_reviewed_by_fkey FOREIGN KEY (reviewed_by) REFERENCES auth.users(id)
);
CREATE TABLE public.interactions (
